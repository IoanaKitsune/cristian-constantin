---
import { services } from "../data/content";
---

<section id="services" class="relative px-6 md:px-12 py-32">
  <p class="reveal text-xs tracking-wide-caps text-accent mb-3">{services.eyebrow}</p>
  <h2 class="reveal font-display text-4xl md:text-5xl mb-16">{services.title}</h2>

  <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-start">
    <div class="reveal relative rounded-2xl overflow-hidden border border-line bg-bg-elevated aspect-[4/5]">
      <div class="absolute inset-0 bg-gradient-to-br from-accent-soft/30 via-bg-elevated to-bg"></div>
      <span class="absolute bottom-4 left-4 text-[10px] tracking-wide-caps text-ink/80 bg-bg/60 px-3 py-1.5 rounded-full">
        {services.imageCaption}
      </span>
    </div>

    <div class="divide-y divide-line">
      {services.list.map((item) => (
        <div class="reveal group flex items-center justify-between gap-4 py-6">
          <div class="flex items-start gap-4 md:gap-6">
            <span class="font-display text-sm text-muted mt-1">{item.number}</span>
            <div>
              <span class="block text-[10px] tracking-wide-caps text-accent mb-1">{item.tag}</span>
              <h3 class="font-display text-lg md:text-xl group-hover:text-accent transition-colors">
                {item.title}
              </h3>
            </div>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <span class="text-[10px] tracking-wide-caps text-muted">{item.duration}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-muted group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
