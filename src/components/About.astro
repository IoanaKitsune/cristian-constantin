---
import { about } from "../data/content";
---

<section id="about" class="relative px-6 py-32 md:py-40 flex flex-col items-center text-center">
  <div class="reveal w-px h-10 bg-line mb-6"></div>
  <p class="reveal text-xs tracking-wide-caps text-accent mb-4">{about.eyebrow}</p>
  <h2 class="reveal font-display text-3xl md:text-5xl mb-8">{about.title}</h2>
  <p class="reveal font-display italic text-lg md:text-xl text-ink/90 max-w-xl mb-6">
    &ldquo;{about.quote}&rdquo;
  </p>
  <p class="reveal max-w-md text-muted text-sm md:text-base mb-16">{about.body}</p>

  <div class="reveal grid grid-cols-3 gap-10 md:gap-20 border-t border-line pt-10 w-full max-w-xl mb-16">
    {about.stats.map((stat) => (
      <div class="flex flex-col items-center">
        <span class="font-display text-2xl md:text-3xl text-accent">{stat.value}</span>
        <span class="text-[10px] tracking-wide-caps text-muted mt-2 text-center">{stat.label}</span>
      </div>
    ))}
  </div>

  <div class="reveal relative w-full max-w-xl aspect-[16/9] rounded-2xl overflow-hidden border border-line mt-16">
    <img src={about.educationImageSrc} alt={about.educationImageAlt} class="absolute inset-0 w-full h-full object-cover" />
  </div>

  <div class="reveal grid sm:grid-cols-2 gap-10 md:gap-20 border-t border-line pt-10 w-full max-w-xl text-left">
    <div>
      <h3 class="text-xs tracking-wide-caps text-accent mb-4">{about.education.title}</h3>
      <ul class="space-y-2">
        {about.education.items.map((item) => (
          <li class="text-muted text-sm">{item}</li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="text-xs tracking-wide-caps text-accent mb-4">{about.specializations.title}</h3>
      <ul class="space-y-2">
        {about.specializations.items.map((item) => (
          <li class="text-muted text-sm">{item}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
