---
import { site, nav } from "../data/content";
---

<header class="fixed top-0 inset-x-0 z-50 flex items-center justify-between px-6 md:px-12 py-5 text-ink bg-bg/80 backdrop-blur-md border-b border-line">
  <a href="#top" class="font-display text-sm tracking-wide-caps">
    {site.name}
    <span class="block text-[10px] text-muted tracking-wide-caps mt-0.5">{site.role}</span>
  </a>

  <nav class="hidden md:flex items-center gap-8 text-xs tracking-wide-caps text-muted">
    {nav.map((item) => (
      <a href={item.href} class="hover:text-ink transition-colors">{item.label}</a>
    ))}
  </nav>

  <a
    href="#contact"
    class="text-xs tracking-wide-caps border border-line rounded-full px-5 py-2 hover:border-accent hover:text-accent transition-colors"
  >
    Contacteaza-ma
  </a>
</header>
