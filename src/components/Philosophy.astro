---
import { philosophy } from "../data/content";
---

<section id="philosophy" class="relative px-6 py-32 flex flex-col items-center text-center">
  <p class="reveal text-xs tracking-wide-caps text-accent mb-3">{philosophy.eyebrow}</p>
  <h2 class="reveal font-display text-4xl md:text-5xl mb-4">{philosophy.title}</h2>
  <p class="reveal text-muted text-sm max-w-md mb-16">{philosophy.subtitle}</p>

  <div class="grid md:grid-cols-3 gap-6 w-full max-w-5xl">
    {philosophy.pillars.map((pillar) => (
      <div
        class:list={[
          "reveal text-left rounded-2xl border p-8 flex flex-col",
          pillar.featured
            ? "border-accent bg-accent-soft/15 md:-translate-y-4"
            : "border-line bg-bg-elevated/40",
        ]}
      >
        <div class="flex items-center justify-between mb-6">
          <span class="text-[10px] tracking-wide-caps text-muted">Level {pillar.level}</span>
          {pillar.featured && (
            <span class="text-[10px] tracking-wide-caps bg-accent text-bg rounded-full px-3 py-1">
              Core Axis
            </span>
          )}
        </div>
        <h3 class="font-display text-2xl mb-5">{pillar.title}</h3>
        <ul class="space-y-2 text-sm text-muted mb-8">
          {pillar.points.map((point) => (
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1">&middot;</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
