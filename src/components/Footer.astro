---
import { footer, nav } from "../data/content";
---

<footer class="relative px-6 md:px-12 py-10 border-t border-line flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] tracking-wide-caps text-muted">
  <span>{footer.text}</span>
  <nav class="flex items-center gap-6">
    {nav.map((item) => (
      <a href={item.href} class="hover:text-ink transition-colors">{item.label}</a>
    ))}
  </nav>
</footer>
